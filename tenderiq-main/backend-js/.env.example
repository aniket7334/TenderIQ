# Copy to .env and fill in real values. Never commit .env.
# mysql://user:password@host:port/database  (cloud: add ?ssl=true or set DB_SSL=true)
DATABASE_URL=
DB_SSL=
DB_CONNECTION_LIMIT=

JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_NAME=
APP_URL=
# Comma-separated site addresses allowed to call the API, e.g. https://tenderiq.vercel.app,http://localhost:5173
CORS_ORIGINS=
PORT=
DEBUG=
