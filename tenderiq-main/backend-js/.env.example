# Copy to .env and fill in real values. Never commit .env.
# mysql://user:password@host:port/database  (cloud: add ?ssl=true or set DB_SSL=true)
DATABASE_URL=
DB_SSL=
DB_CONNECTION_LIMIT=

JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_NAME=
APP_URL=
# Comma-separated site addresses allowed to call the API, e.g. https://tenderiq.vercel.app,http://localhost:5173
CORS_ORIGINS=
PORT=
DEBUG=

# Live GeM sync: minutes between checks for new bids (default 5)
GEM_SYNC_MINUTES=5
# Render only: set to false to let the free server sleep (stops the live sync)
KEEP_AWAKE=true

# GeM relay (Render only): GeM refuses Render's servers, so GeM requests go
# through a Vercel function in Mumbai. Leave both empty locally (India works direct).
GEM_PROXY_URL=
GEM_PROXY_KEY=

# Optional: OpenAI model for translating World Bank notices to English (uses OPENAI_API_KEY)
TRANSLATE_MODEL=gpt-4o-mini

# Minutes between background refreshes of live sources (TED, Find a Tender, World Bank); default 5
LIVE_SYNC_MINUTES=5

# Sign-up approval: company email domains approved automatically (comma list, e.g. meka.com).
# Empty = every new sign-up waits for an admin in Admin -> Users.
SIGNUP_AUTO_APPROVE_DOMAINS=
# Proxies in front of the API: 1 = Render only (local: 1), 2 = Vercel forwarding + Render (production)
TRUST_PROXY_HOPS=1
