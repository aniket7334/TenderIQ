# Copy to .env.local for local development, or set in Vercel → Settings → Environment Variables.
# The address of the TenderIQ API (your Render service) followed by /api/v1
VITE_API_URL=https://tenderiq-api.onrender.com/api/v1

# Show the demo quick-login buttons on the sign-in page (local dev shows them anyway).
# Leave this unset in production — the demo accounts are not copied to the cloud database.
# VITE_SHOW_DEMO_ACCOUNTS=true
