# Copy to .env.local for local development, or set in Vercel → Settings → Environment Variables.
# The API is reached on the site's own address: /api/v1 (Vercel forwards it to Render — see
# vercel.json; Vite forwards it to localhost:8000 in development). Only set VITE_API_URL to a
# different PATH if needed; full addresses are ignored (login cookies must stay first-party).
# VITE_API_URL=/api/v1

# Show the demo quick-login buttons on the sign-in page (local dev shows them anyway).
# Leave this unset in production — the demo accounts are not copied to the cloud database.
# VITE_SHOW_DEMO_ACCOUNTS=true

# Vercel only (Project Settings > Environment Variables, NOT a VITE_ variable):
# shared key for the GeM relay function api/gem-proxy.js. Same value as on Render.
# GEM_PROXY_KEY=
